# Environment Variables — Frontend (Chrome Extension)
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================================
# Backend API
# ============================================================================

VITE_API_BASE_URL=http://localhost:8000/api/v1

# ============================================================================
# GitHub OAuth
# ============================================================================

# Uses same OAuth app as backend
VITE_GITHUB_CLIENT_ID=your-github-oauth-client-id

# ============================================================================
# Feature Flags
# ============================================================================

VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_THEME_TOGGLE=true

# ============================================================================
# Extension Configuration
# ============================================================================

# Auto-generated after loading unpacked extension
VITE_EXTENSION_ID=your-extension-id

# Caching
VITE_MAX_CACHED_JOBS=3

# Polling intervals (comma-separated backoff in ms)
VITE_POLL_INTERVALS=1000,2000,5000,10000

# ============================================================================
# Notes
# ============================================================================

# 1. Never commit .env to version control
# 2. VITE_ prefix required for Vite to expose vars to browser
# 3. Backend URL must match deployed backend or localhost for dev
# 4. Extension ID changes each time you load unpacked (use for dev only)
