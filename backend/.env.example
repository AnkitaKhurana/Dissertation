# Environment Variables — Backend (FastAPI)
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================================
# Application
# ============================================================================

ENVIRONMENT=development  # development, staging, production
DEBUG=true
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# ============================================================================
# Security
# ============================================================================

# Generate JWT secret with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-replace-with-real-secret-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440  # 24 hours
CSRF_SECRET=your-csrf-secret-here-replace-with-real-secret

# ============================================================================
# CORS
# ============================================================================

ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*

# ============================================================================
# GitHub OAuth App (User Authentication)
# ============================================================================

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ============================================================================
# GitHub App (Server-Side API Calls)
# ============================================================================

# Create a GitHub App at https://github.com/settings/apps/new
GITHUB_APP_TOKEN=your-github-app-installation-token

# ============================================================================
# Database (MongoDB)
# ============================================================================

MONGO_URI=mongodb://localhost:27017/pr_sentinel_dev
MONGO_DB_NAME=pr_sentinel
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1

# ============================================================================
# LLM Configuration
# ============================================================================

# Hosted LLM Provider (for Pro/Admin users)
HOSTED_LLM_PROVIDER=huggingface  # openai, anthropic, huggingface
HOSTED_LLM_KEY=
HOSTED_LLM_MODEL=gpt-4

# Hugging Face Inference Providers API (recommended for coding models)
# Uses OpenAI-compatible chat completions: https://router.huggingface.co/v1/chat/completions
# Get token from: https://huggingface.co/settings/tokens/new
HF_API_TOKEN=hf_your_token_here
# Recommended models: deepseek-ai/deepseek-coder-6.7b-instruct (best quality), 
#                     codellama/CodeLlama-13b-Instruct-hf (balanced), 
#                     bigcode/starcoder2-7b (fastest)
HF_MODEL=deepseek-ai/deepseek-coder-6.7b-instruct
HF_MAX_NEW_TOKENS=2048
HF_TEMPERATURE=0.1
HF_USE_STREAMING=false

# ============================================================================
# Rate Limiting
# ============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_STORAGE=memory  # memory or redis

# Redis (for distributed rate limiting)
REDIS_URI=redis://localhost:6379

# ============================================================================
# Job Configuration
# ============================================================================

MAX_PR_FILES=500  # Reject PRs with more files (HTTP 413)
JOB_TIMEOUT_SECONDS=300  # 5 minutes
AGENT_TIMEOUT_SECONDS=30  # Per-agent timeout
BACKGROUND_TASK_MAX_RETRIES=3

# TTL Retention (in seconds)
JOB_RETENTION_FREE_TIER=86400    # 1 day
JOB_RETENTION_PRO_TIER=432000    # 5 days
JOB_RETENTION_ADMIN_TIER=432000  # 5 days

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_REDACT_SECRETS=true

# ============================================================================
# Azure Key Vault (Production)
# ============================================================================

AZURE_KEY_VAULT_ENABLED=false
AZURE_KEY_VAULT_NAME=your-key-vault-name
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# ============================================================================
# Testing
# ============================================================================

TEST_MONGO_URI=mongodb://localhost:27017/pr_sentinel_test
USE_MOCK_ADAPTERS=true

# ============================================================================
# Notes
# ============================================================================

# 1. Never commit .env to version control
# 2. Use Azure Key Vault for production secrets
# 3. Rotate secrets regularly
# 4. Use strong, unique secrets for JWT_SECRET and CSRF_SECRET
# 5. For GitHub App token, use installation tokens
